{
  "name": "dump-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "node scripts/design-tokens.mjs --check && eslint . && prettier --check . && tsc --noEmit",
    "format": "prettier --write .",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "design:lint": "design.md lint DESIGN.md",
    "design:tokens": "node scripts/design-tokens.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@google/design.md": "0.4.0",
    "axe-core": "^4.14.0",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=24"
  }
}
